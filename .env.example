# ─── 必填 ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/mirrai
# 生产环境必填。生成随机密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── AI 提供商（至少配置一个）─────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# 可选：给这个 provider 的系统提示词额外追加一段说明（原样拼在系统消息里）。
# 留空则不加。一般不需要。
OPENAI_SYSTEM_MESSAGE=

# Atlas Cloud (OpenAI-compatible; requests are submitted once without automatic retries)
ATLASCLOUD_API_KEY=
ATLAS_BASE_URL=https://api.atlascloud.ai/v1
ATLAS_MODEL=google/gemini-3-flash-preview

# Cheaper Inference (OpenAI-compatible)
CHEAPER_INFERENCE_API_KEY=
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1
CHEAPER_INFERENCE_MODEL=gpt-5.4-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Kimi (Moonshot)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_BASE_URL=https://api.anthropic.com

# Ollama (本地)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Local embeddings for exemplar retrieval (https://docs.ollama.com/api/embed)
OLLAMA_EMBED_MODEL=bge-m3
# System prompt order. classic = current order; cache = stable prefix then volatile
# (Claude prompt cache: https://platform.claude.com/docs/en/build-with-claude/prompt-caching)
PROMPT_LAYOUT=classic

# Dify
DIFY_API_KEY=
DIFY_URL=

# 讯飞星火
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_MODEL_VERSION=v3.5

# 通义千问
TONGYI_API_KEY=
TONGYI_URL=
TONGYI_MODEL=qwen-turbo

# 豆包
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL=

# 302AI
_302AI_API_KEY=

# ─── 微信机器人（可选）──────────────────────────────────────────────────────
# 微信官方 ClawBot 通道（腾讯 iLink 协议）。需微信 8.0.70+ 且「我→设置→插件」中有「微信 ClawBot」入口。
WECHAT_ENABLED=false
# 扫码登录使用的 bot_type（对齐官方插件默认值）
WECHAT_BOT_TYPE=3
# 腾讯 iLink API 地址（一般无需修改）
WECHAT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_ILINK_CDN_URL=https://novac2c.cdn.weixin.qq.com/c2c
# iLink 应用标识
WECHAT_ILINK_APP_ID=bot
# 可选的部署路由标签
WECHAT_ROUTE_TAG=
# 应用版本号，会作为 channel_version 上报给 iLink 后端
# 留空则使用 package.json 里的版本号——那里才是版本号唯一被写下来的地方
APP_VERSION=

# ─── 其他 ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
PYTHON_PATH=python3
SKILL_ENGINE_DIR=./skill-engine
PORT=3000
# AI 身份透明：true（默认）= 被认真询问时承认是 AI；false = 完全沉浸模式
PERSONA_AI_TRANSPARENCY=true
# 情绪判定引擎：llm（默认，模型阅读对话后判断情绪）/ heuristic（纯关键词规则，零额外 LLM 调用）
EMOTION_ENGINE=llm

# ─── 安全 ───────────────────────────────────────────────────────────────────
# 允许发起写操作的其他来源（逗号分隔）。同源始终允许；仅在把 Mirrai 嵌入到
# 另一个站点时才需要填写。
# The proxies whose X-Forwarded-For header may be believed.
#
# Empty by default. Put the app behind nginx and set this to the proxy's
# address (127.0.0.1, or the Docker network's) and the real client
# address is read from the header again. While it is empty the address
# of the connection is used, which cannot be forged.
TRUSTED_PROXIES=

ALLOWED_ORIGINS=
# 会话 Cookie 的 SameSite 策略：lax（默认，推荐）/ none / strict。
# "none" 需要 HTTPS，且必须配合上面的 Origin 校验使用。
COOKIE_SAMESITE=lax
# 首次运行时自动创建本地管理员：auto（默认）/ manual（改为走注册流程）
MIRRAI_BOOTSTRAP_ADMIN=auto
# 首次运行凭据与数据文件的存放目录。桌面版会自动设置；留空则使用 UPLOAD_DIR 的上级目录。
MIRRAI_DATA_ROOT=
# 危机支持资源清单的覆盖文件（JSON）。留空则使用内置清单。
SAFETY_RESOURCES_FILE=

# ─── 主动提醒 ───────────────────────────────────────────────────────────────
# 免打扰时段，格式 "HH:MM-HH:MM"。跨越午夜时会覆盖夜里和清晨。
REMINDER_QUIET_HOURS=23:00-08:00

# ─── 本地语音转写 ───────────────────────────────────────────────────────────
# 语音消息由谁来听：
#   provider（默认）—— 用上面配置的 provider 的 /audio/transcriptions。
#                    只有 OpenAI 兼容的那几个 provider 有这个接口。
#   whisper-cpp    —— 本机的 whisper.cpp 可执行文件，需要同时装 ffmpeg。
#   http           —— 你自己起的、OpenAI 兼容的 /v1/audio/transcriptions
#                    （faster-whisper、SenseVoice 之类）。
#   off            —— 不转写；界面会说「没听清」，不会编造内容。
# 导入的记录里 TA 的真实录音只走本机引擎（whisper-cpp / http 且地址是本机），
# 没有开关可以改变这一点。
STT_ENGINE=provider
# whisper.cpp 的可执行文件和 GGML 模型文件（都是本机路径）。
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=
# http 引擎的完整地址，例如 http://127.0.0.1:8000/v1/audio/transcriptions。
# 默认只接受回环和私有网段；公网地址会被拒绝。
STT_HTTP_URL=
# provider 引擎转写时用的模型名（OpenAI 兼容的 /audio/transcriptions）。
OPENAI_TRANSCRIBE_MODEL=whisper-1
# 有些服务按模型名分发；留空用 whisper-1。
STT_HTTP_MODEL=
# 有些本机服务要求一个 Bearer token；留空就不发。
STT_HTTP_API_KEY=
# 确实要把录音发到别处时才打开。导入的录音仍然不会走这里。
STT_HTTP_ALLOW_REMOTE=false

# ─── 朗读 ────────────────────────────────────────────────────────────────────
# 「朗读」默认用微软的在线语音服务：回复的文字会发给他们，音频再传回来。
# 想完全关掉就设 TTS_ENABLED=false（界面上也不会再出现朗读按钮）；
# 想在本机合成就把 TTS_ENGINE 改成 piper 或 http（见下），文字不会发出去。
TTS_ENABLED=true
# 谁来合成声音：
#   edge（默认）—— 微软的在线语音服务，回复的文字会发给他们。
#   piper        —— 本机 piper 可执行文件，文字不出本机。装了 ffmpeg 就转成 mp3，
#                    没装就直接存 WAV。
#   http         —— 本机（或局域网）的 OpenAI 兼容 /audio/speech。
#   off          —— 不提供朗读。
TTS_ENGINE=edge
# piper 的可执行文件和模型文件。
PIPER_BIN=
PIPER_MODEL=
# http 引擎的完整地址，例如 http://127.0.0.1:8880/v1/audio/speech。
# 默认只接受回环和私有网段。
TTS_HTTP_URL=
TTS_HTTP_MODEL=
TTS_HTTP_VOICE=
TTS_HTTP_API_KEY=

# ─── 网页推送（可选）────────────────────────────────────────────────────────
# 应用关着的时候提醒用户。负载经 web-push 加密后发给浏览器给出的推送地址。
# 留空时，第一次需要密钥会在数据目录写入 vapid.json（权限 0600）。
# 自托管请把 VAPID_SUBJECT 改成你自己的联系邮箱。
# https://github.com/web-push-libs/web-push#usage
VAPID_SUBJECT=mailto:mirrai@localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Redis（可选，开箱即用）────────────────────────────────────────────────
# Redis 只在「跑着不止一份 Mirrai」的时候才有意义：限流额度记在共享的桶里，
# 调度器的锁保证同一封提醒不会被送两遍。
#
# 什么都不用填。应用会按这个顺序找 Redis：
#   1. 下面这个 REDIS_URL（如果填了）
#   2. 已经在默认端口上跑着的 Redis
#   3. 跟着应用一起装的那一个（macOS/Windows/Docker 的安装包里都带着）
#   4. 应用自己起的一个（和这台机器上别的 Mirrai 共享）
#
# 机器上没有 redis-server 也不影响使用——限流退回进程内计数，日志里会写明。
# 从源码跑的时候想装一个：pnpm setup:redis
REDIS_URL=
# auto（默认）/ managed（强制自己起一个）/ off（完全不用 Redis）
MIRRAI_REDIS=auto
# 指定的 redis-server 可执行文件路径；留空自动找（随应用打包的、Homebrew 的、
# 或者 PATH 里的）。应用自己起的 Redis 用它。
REDIS_SERVER_BIN=

# ─── OpenAI 兼容端点（C9.2）─────────────────────────────────────────────────
# 让别的程序（编辑器插件、脚本、任何 OpenAI 客户端）把某个分身穿成 OpenAI 的
# 模型来用。密钥在「设置 → AI → OpenAI 兼容端点」里创建，只有创建时显示一次。
# 默认没有任何密钥，所以这个端点默认等于关着；不需要就设成 false 整个关掉。
# 接口和与真 OpenAI 的差异见 docs/api.md。
OPENAI_COMPAT_ENABLED=true

# ─── 本地插件（C9.7）────────────────────────────────────────────────────────
# 打开后，应用启动时会读 <数据目录>/plugins/*/index.mjs。插件在应用进程里
# 运行，权限和应用本身一样大——只放你读过、信得过的代码。默认关。
# 写法、两种插件（导入器 / 通道）的形状与示例见 docs/plugins.md。
MIRRAI_PLUGINS=off

# ─── 第六阶段（v6）─────────────────────────────────────────────────────────
# 下面是第六阶段新增的配置。默认值都是「不联网、不额外花钱」的那一档。

# 单个导入文件的上限（字节）。默认 2 GiB；超过 int4 上限时按 2147483647 算。
MAX_IMPORT_BYTES=2147483647
# 归档包（zip 等）解开后的总上限（字节）。默认 8 GiB。
MAX_IMPORT_UNPACKED_BYTES=8589934592

# 可选：地图底图的瓦片地址，例如 https://<tile-host>/{z}/{x}/{y}.png。
# 留空时「去过的地方」没有底图，地图开关根本不出现。瓦片服务器能看到你在看哪里。
MAP_TILE_URL=

# 天气功能的总开关。false 时整个实例没有天气；每个分身的天气开关仍然默认关。
# 打开后，用户点「查找城市」会向 Open-Meteo 发一次城市名，之后只发四舍五入的经纬度。
WEATHER_ENABLED=true

# MCP 服务（corepack pnpm mcp）用来确认身份的只读密钥。它不放在应用进程里：
# 在 AI 客户端的配置里设置它；密钥在 设置 → AI → OpenAI 兼容端点 创建，只有创建时显示一次。
# 详见 docs/mcp.md。
MIRRAI_API_KEY=

# 蒸馏一次最多调用多少次模型（超过先问用户）。默认 600。
MAX_DISTILL_CALLS=600
# 毕业建议被拒绝或忽略之后，隔多少天可以再提一次。默认 7。
MIRRAI_GRADUATION_RESUGGEST_DAYS=7

# 开发服务器额外允许的 Host（用手机访问 vite dev server 时填），逗号分隔。
DEV_ALLOWED_HOSTS=

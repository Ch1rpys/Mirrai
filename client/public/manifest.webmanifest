{
  "name": "Mirrai",
  "short_name": "Mirrai",
  "description": "上传聊天记录，AI 重建 TA 的数字分身。不在身边的时候，TA 还在这里。 / Upload your chats and let AI rebuild them as a digital persona. They are here even when you are not.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#2A1F4E",
  "theme_color": "#6E5AC8",
  "lang": "zh-CN",
  "categories": [
    "lifestyle",
    "social"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "大厅 / Lobby",
      "short_name": "大厅 / Lobby",
      "url": "/",
      "description": "管理你的数字分身 / Manage your digital personas"
    },
    {
      "name": "对话日记 / Diary",
      "short_name": "日记 / Diary",
      "url": "/diary",
      "description": "回看 AI 生成的对话日记 / Read the diary the app wrote"
    },
    {
      "name": "信箱 / Mailbox",
      "short_name": "信箱 / Mailbox",
      "url": "/letters",
      "description": "所有分身的信、回信和胶囊 / Letters, replies and capsules from every persona"
    },
    {
      "name": "最近聊的 / Last chat",
      "short_name": "最近聊的 / Last chat",
      "url": "/chat/last",
      "description": "回到最近聊过的那个分身 / Return to the persona you spoke to last"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "text/*",
            "application/zip",
            "application/json",
            ".csv",
            ".html"
          ]
        }
      ]
    }
  }
}
